{
  "name": "agent-army-stronghold",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Guarded mission-control dashboard for Chris's Hermes agent army and Engineering Division.",
  "scripts": {
    "snapshot": "node scripts/generate-snapshot.mjs",
    "dev": "npm run snapshot && vite --host 127.0.0.1 --port 5174",
    "server:dev": "tsx server/index.ts",
    "build": "npm run snapshot && tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "latest",
    "jsdom": "latest",
    "tsx": "latest"
  }
}
